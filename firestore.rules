rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Profils utilisateurs ----------
    // Lecture publique (affichage du nom/ville du vendeur), écriture réservée au propriétaire.
    match /profils/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ---------- Produits ----------
    // Lecture publique (catalogue).
    // Création, suppression et modification complète réservées au vendeur propriétaire.
    // Mise à jour du stock uniquement (quantite, statut) autorisée aux membres authentifiés
    // lors d'une commande ou d'une annulation de commande.
    match /produits/{produitId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.vendeurId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.vendeurId
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantite', 'statut'])
          && request.resource.data.quantite is number
          && request.resource.data.quantite >= 0
          && request.resource.data.statut in ['actif', 'inactif']
        )
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.vendeurId;
    }

    // ---------- Commandes ----------
    // Lecture et mise à jour du statut par l'acheteur ou l'un des vendeurs impliqués.
    match /commandes/{commandeId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.acheteurId
        || ('vendeurIds' in resource.data && request.auth.uid in resource.data.vendeurIds)
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.acheteurId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.acheteurId
        || ('vendeurIds' in resource.data && request.auth.uid in resource.data.vendeurIds)
      );
      allow delete: if false;
    }

    // ---------- Compteur de numéros de commande ----------
    match /compteurs/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
