rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Profils utilisateurs ----------
    // Lecture publique, écriture réservée au propriétaire du profil.
    match /profils/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ---------- Produits ----------
    // Lecture publique (catalogue), écriture réservée au vendeur du produit.
    match /produits/{produitId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.vendeurId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.vendeurId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.vendeurId;
    }

    // ---------- Commandes ----------
    // Lecture si acheteur ou l'un des vendeurs impliqués.
    // Création réservée à l'acheteur.
    // Mise à jour (statut) réservée à l'acheteur ou aux vendeurs.
    match /commandes/{commandeId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.acheteurId
            || request.auth.uid in (resource.data.vendeurIds || []));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.acheteurId;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.acheteurId
            || request.auth.uid in (resource.data.vendeurIds || []));
      allow delete: if false;
    }

    // ---------- Compteur de numéros de commande ----------
    match /compteurs/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
