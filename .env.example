# ---------------------------------------------------------------------------
# BWAKA — configuration Supabase
# Copiez ce fichier en .env.local puis renseignez les valeurs de votre projet
# (Supabase Dashboard > Project Settings > API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service_role : UNIQUEMENT côté serveur (jamais exposée au navigateur)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secret utilisé pour signer les sessions du mode démonstration
BWAKA_DEMO_SECRET=change-me
